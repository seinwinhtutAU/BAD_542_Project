NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://user:password@localhost:3306/campus_health"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# Service principal used to authenticate THIS APP to Azure Key Vault (DefaultAzureCredential
# reads these exact names). Not related to the two variables below.
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The Azure AD App Registration users sign into (separate from the service principal above).
# Must match the frontend's VITE_AZURE_AD_TENANT_ID / VITE_AZURE_AD_CLIENT_ID.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# Comma-separated email domains permitted to sign in via Azure AD.
ALLOWED_EMAIL_DOMAINS=au.edu

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
