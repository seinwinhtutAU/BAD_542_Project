# Shared reference only — backend/ and frontend/ each have their own .env
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Baked into the frontend at build time (docker-compose.yml passes these as build args).
# Must match backend/.env's AZURE_AD_CLIENT_ID / AZURE_AD_TENANT_ID.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=https://seinwinhtut-bad2026.centralindia.cloudapp.azure.com/project/
